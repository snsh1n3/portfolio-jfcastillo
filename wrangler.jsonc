{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jfcastillo-portfolio",
  // Update to the day of the first deploy.
  "compatibility_date": "2026-10-20",
  // Static site: no Worker script, only Static Assets.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Public access only through the custom domain, as in Chusquisimas V2.
  "workers_dev": false,
  "preview_urls": false,
  // `wrangler deploy` attaches this domain to the Worker (creates its DNS record).
  // Do not deploy until the zone review in README.md has been done.
  "routes": [
    { "pattern": "jfcastillo.chusquisimas.com", "custom_domain": true }
  ]
}
