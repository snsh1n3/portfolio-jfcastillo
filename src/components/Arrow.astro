---
// Inline SVG instead of the ↗ / ↓ glyphs: the self-hosted Latin subset does not include U+2197.
interface Props { dir?: 'ne' | 'down' }
const { dir = 'ne' } = Astro.props;
---
<svg class:list={['arr', { dn: dir === 'down' }]} viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true" focusable="false">
  {dir === 'ne' ? <path d="M2 10 10 2M4 2h6v6" /> : <path d="M6 1v10M2 7l4 4 4-4" />}
</svg>
